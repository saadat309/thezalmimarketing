{
  "name": "zalmi-ssr-runtime-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.js dev --host 127.0.0.1 --port 4175",
    "build": "node scripts/run-vite.js build",
    "preview": "node scripts/run-vite.js preview --host 127.0.0.1 --port 4175",
    "smoke": "node scripts/smoke.js",
    "db:migrate:local": "wrangler d1 migrations apply zalmi-staging-local --local",
    "db:seed:local": "node scripts/seed-local-directories.js && node scripts/seed-local-properties.js",
    "test:property": "node scripts/test-property-api.js && node --disable-warning=ExperimentalWarning scripts/test-property-storage.js",
    "test:directory": "node scripts/test-directory-api.js && node --disable-warning=ExperimentalWarning scripts/test-directory-storage.js",
    "test:admin-auth": "node scripts/test-admin-auth.js && node scripts/test-admin-data.js && node scripts/test-calculator-import.js && node --disable-warning=ExperimentalWarning scripts/test-admin-storage.js",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^8.0.0",
    "wrangler": "latest"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true
  }
}
